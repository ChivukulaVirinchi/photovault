<?xml version="1.0" encoding="windows-1252"?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="PhotoVault"
      UpgradeCode="4A77AF0F-EF2D-4A25-9DAA-FA5C4F3BEA11"
      Manufacturer="Virinchi Chivukula"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)">

    <Package
        Id="*"
        Keywords="Installer"
        Description="Offline-first desktop photo library manager"
        Manufacturer="Virinchi Chivukula"
        InstallerVersion="450"
        Languages="1033"
        Compressed="yes"
        InstallScope="perMachine"
        SummaryCodepage="1252" />

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
    <Property Id="DiskPrompt" Value="PhotoVault Installation" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ChivukulaVirinchi/photovault/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ChivukulaVirinchi/photovault" />

    <Icon Id="ProductICO" SourceFile="packaging\photovault.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductICO" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.PlatformProgramFilesFolder)">
        <Directory Id="INSTALLFOLDER" Name="PhotoVault" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="PhotoVault" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File
            Id="PhotoVaultExe"
            Name="photovault.exe"
            Source="$(var.CargoTargetBinDir)\photovault.exe"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="PhotoVault"
            Description="Offline-first photo library manager"
            Target="[INSTALLFOLDER]photovault.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ProgramMenuDirRemove" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\PhotoVault"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
        Id="MainFeature"
        Title="PhotoVault"
        Description="Core PhotoVault application files"
        Level="1"
        ConfigurableDirectory="INSTALLFOLDER"
        AllowAdvertise="no"
        Display="expand"
        Absent="disallow">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <WixVariable Id="WixUIBannerBmp" Value="packaging\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="packaging\wix-dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\wix-license.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <UIRef Id="WixUI_ErrorProgressText" />
    </UI>
  </Product>
</Wix>
