{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoVault",
  "version": "0.2.0",
  "identifier": "dev.photovault.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../src-ui",
    "beforeBuildCommand": "npm run build --prefix ../src-ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoVault",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
