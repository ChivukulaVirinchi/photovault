/target
/target-win
/artifacts/

# Tauri build artifacts (generated by tauri-build at compile time)
/src-tauri/gen/
/src-tauri/target/

# Frontend build artifacts (Vite owns /src-ui/dist; tauri.conf's
# beforeBuildCommand re-runs `npm run build` before any bundle)
/src-ui/dist/
/src-ui/node_modules/
/src-ui/.svelte-kit/

# Claude Code session state
/.claude/

# ONNX Runtime shared library (~22MB, downloaded separately)
/libs/

# ONNX model files (~260MB total, downloaded separately)
/models/

# Downloaded data and build cache
/data/*
!/data/README.md
/.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
